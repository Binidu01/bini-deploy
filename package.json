{
  "name": "bini-deploy",
  "version": "1.0.15",
  "description": "Deploy Bini.js projects to any platform",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "bini-deploy": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "deploy": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "postbuild": "node -e \"try{require('fs').chmodSync('dist/index.js', 0o755)}catch(e){}\""
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^6.0.0",
    "cross-spawn": "^7.0.6",
    "ora": "^9.4.1"
  },
  "peerDependencies": {
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "bini",
    "deploy",
    "vercel",
    "netlify",
    "cloudflare",
    "deno",
    "tauri",
    "capacitor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Binidu01/bini-deploy.git"
  },
  "bugs": {
    "url": "https://github.com/Binidu01/bini-deploy/issues"
  },
  "homepage": "https://github.com/Binidu01/bini-deploy#readme"
}