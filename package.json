{
  "name": "bini-deploy",
  "version": "2.1.1",
  "description": "Deploy Bini.js projects to any platform",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "bini-deploy": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "deploy": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cross-spawn": "^7.0.6",
    "simple-git": "^3.27.0"
  },
  "peerDependencies": {
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "bini",
    "bini.js",
    "deploy",
    "vercel",
    "netlify",
    "cloudflare",
    "deno",
    "tauri",
    "desktop",
    "android",
    "ios",
    "github-actions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Binidu01/bini-deploy.git"
  },
  "bugs": {
    "url": "https://github.com/Binidu01/bini-deploy/issues"
  },
  "homepage": "https://github.com/Binidu01/bini-deploy#readme"
}